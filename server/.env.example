# ---- Runtime ----
NODE_ENV=development
PORT=5000
CHECKIN_TIMEZONE=UTC
# ---- URLs (CORS is locked to CLIENT_URL) ----
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/devcircle

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=14
# Production only. true  = client and server are on different sites (vercel.app + onrender.com) -> SameSite=None
#                  false = both on subdomains of one domain (app.x.dev + api.x.dev)            -> SameSite=Lax
CROSS_SITE_COOKIES=true
# Optional, e.g. ".devcircle.dev" when sharing a cookie across subdomains
COOKIE_DOMAIN=

# ---- GitHub OAuth (primary) ----
# Callback URL to register: {SERVER_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Google OAuth (only used if the google-auth module is enabled) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Gemini (only used if ai-summaries is enabled). Server-side only. ----
GEMINI_API_KEY=
